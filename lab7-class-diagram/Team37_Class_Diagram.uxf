<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>
  <element>
    <id>UMLClass</id>
    <coordinates><x>40</x><y>40</y><w>240</w><h>130</h></coordinates>
    <panel_attributes>Warehouse
--
-location: String
-cases: List&lt;Case&gt;
--
+addCase(c: Case)
+removeCase(c: Case)
+getCount(f: Figurine): int</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>360</x><y>40</y><w>240</w><h>130</h></coordinates>
    <panel_attributes>Case
--
-caseId: int
-figurines: List&lt;Figurine&gt;
--
+addFigurine(f: Figurine)
+removeFigurine(f: Figurine)
+getCount(f: Figurine): int</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>680</x><y>40</y><w>240</w><h>130</h></coordinates>
    <panel_attributes>Figurine
--
-name: String
-character: String
-company: String</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>40</x><y>300</y><w>240</w><h>130</h></coordinates>
    <panel_attributes>Client
--
-name: String
-address: String
--
+placeOrder(f: Figurine, qty: int): Order</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>360</x><y>300</y><w>240</w><h>130</h></coordinates>
    <panel_attributes>Order
--
-client: Client
-figurine: Figurine
-quantity: int
-cases: List&lt;Case&gt;
--
+ship()</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>270</x><y>80</y><w>100</w><h>40</h></coordinates>
    <panel_attributes>lt=&lt;&lt;&lt;&lt;-
m1=1
m2=0..*
stores</panel_attributes>
    <additional_attributes>10.0;20.0;90.0;20.0</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>590</x><y>80</y><w>100</w><h>40</h></coordinates>
    <panel_attributes>lt=&lt;&lt;&lt;&lt;-
m1=1
m2=1..*
holds</panel_attributes>
    <additional_attributes>10.0;20.0;90.0;20.0</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>270</x><y>340</y><w>100</w><h>40</h></coordinates>
    <panel_attributes>lt=-
m1=1
m2=0..*
places</panel_attributes>
    <additional_attributes>10.0;20.0;90.0;20.0</additional_attributes>
  </element>
  <element>
    <id>Relation</id>
    <coordinates><x>470</x><y>160</y><w>80</w><h>150</h></coordinates>
    <panel_attributes>lt=-
m1=0..1
m2=1..*
ships</panel_attributes>
